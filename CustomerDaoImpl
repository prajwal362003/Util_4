	@Override
	public void updateStatus(Customer customer, String remarks, String status) {
		try {
			logger.info("update status sql \n"+updateStatusSql);
			logger.info("Customer CIF : "+ customer.cifNumber());
			jdbcTemplate.update(updateStatusSql, status, remarks, customer.cifNumber());
		}catch(Exception e) {
			logger.error(" - "+e.getMessage());
		}
	}

	@Override
	public void updateStatusForRejection(Customer customer, String remarks) {
		try {
			logger.info("update status for rejection sql \n"+updateStatusForRejection);
			logger.info("Customer CIF : "+ customer.cifNumber());
			
			jdbcTemplate.update(updateStatusForRejection,  remarks, customer.cifNumber());
		}catch(Exception e) {
			logger.error(" - "+e.getMessage());
		}
	}
}
