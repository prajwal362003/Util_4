@Repository
public class CustomerDaoImpl implements CustomerDao {

	final String fetchStausSql=ExtractProperties.getInstance().getProperty("customer.status.query");
	final String fetchKycDateSql=ExtractProperties.getInstance().getProperty("kyc.date.query");
	final String insertHistorySql=ExtractProperties.getInstance().getProperty("Insert.history.query");
	final String updateStatusSql=ExtractProperties.getInstance().getProperty("update.status.query");
	final String updateStatusForRejection=ExtractProperties.getInstance().getProperty("update.status.for.rejection");

	private static final JdbcTemplate jdbcTemplate = new JdbcTemplate(DataBaseConfiguration.getDataSource());
	//private static final NamedParameterJdbcTemplate namedParameterJdbcTemplate =  new NamedParameterJdbcTemplate(DataBaseConfiguration.getDataSource());
	private static String hostName = ServerConfiguration.getCachedHostname();
	private static final Logger logger = (Logger) LogManager.getLogger(CustomerDaoImpl.class);

	@Override
	public String fetchCifStatusFromPerfiosTable(String cifNumber) {
		try {
			logger.info(" Query to fetch status from kyc perfios customer details \n"+fetchStausSql);
			return jdbcTemplate.queryForObject(fetchStausSql, String.class, cifNumber);
		}catch(Exception e) {
			logger.error("Exception while fetching status from kyc perfios customer details ",e);
			return "";
		}
	}

	@Override
	public String fetchKycDateOfBranch(String cif) {
		try {
			logger.info(" Query to fetch Date from kyc perfios customer details \n"+fetchStausSql);
			return jdbcTemplate.queryForObject(fetchKycDateSql, String.class, cif);
		}catch(Exception e) {
			return "";
		}
	}

	@Override
	public void insertHistory(Customer customer,String ckyc,String customerFolder,String remarks) {
		try {
			logger.info(" Inserting history \n"+insertHistorySql);
			jdbcTemplate.queryForObject(insertHistorySql, String.class, customer.cifNumber(),customer.accountNumber(),ckyc,customer.branchCode(),customerFolder,remarks,hostName);
			//int a=jdbcTemplate.update(historyUpdateSql,customerDetails.getCif(),customerDetails.getAccountNumber(),customerDetails.getCkycNumber(),customerDetails.getBranchCode(),customerDetails.getZipFile(),customerDetails.getRemark(),hostName);
		}catch(Exception e) {
			logger.error(""+e.getMessage());
		}
	}

