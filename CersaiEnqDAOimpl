	public void insertCersaiEnqResponceNew(CERSAI_ENQUIRY_RES cersaiPidData, String Mobile_no, String pincode,
			String dob, String cifNumber,String email,String pinCode2, String mobileNumber2) {

		try {
			logger.info("-----UPDATING insertCersaiEnqResponceNew ---------");
			
			if (namedParameterJdbcTemplate == null) {
				try {
				//	dataSource();
					logger.info("Loading... ");
				} catch (Exception e) {
					logger.error("DATASOURCE ERROR>>>>>>>>>>>>>>>>>>>>" + e.getMessage());
				}
			} else {
				logger.info("jdbc template ");
			}
			
			String sqlInsert = "insert into kycupdate.cersai_bulk_download_request (cif_number,ckyc_number, ckyc_reference_id,date_of_birth,pincode,mobile_number,branch_code,modified_date,modified_by,req_unique_id,email_id,pincode_2,mobile_number_2) "
					+ " Values (:cif_number,:ckyc_number,:ckyc_reference_id,:date_of_birth,:pincode,:mobile_number,:branch_code,:sys_date,'QMS',:req_unique_id,:email,:pincode_2,:mobile_number_2)";
			
			MapSqlParameterSource mp = new MapSqlParameterSource();
			mp.addValue("cif_number", cifNumber);
			mp.addValue("ckyc_number", nullToEmpty(cersaiPidData.getCKYC_NO()));
			mp.addValue("ckyc_reference_id", nullToEmpty(cersaiPidData.getCKYC_REFERENCE_ID()));
			//mp.addValue("date_of_birth", dob);
			
			LocalDate localDoB = null;
			try{
				localDoB=LocalDate.parse(dob, DateTimeFormatter.ofPattern("dd-MM-yyyy"));
			} catch (DateTimeParseException e) {
				localDoB=LocalDateTime.parse(dob, DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")).toLocalDate();
			} catch(Exception e) {
				logger.error("date parse exception  >> " + e.getLocalizedMessage());
			}
			logger.info("localDoBh ---------"+localDoB);
			mp.addValue("date_of_birth", java.sql.Date.valueOf(localDoB));
			
			mp.addValue("pincode", pincode);
			mp.addValue("mobile_number", Mobile_no);
			mp.addValue("branch_code", nullToEmpty(cersaiPidData.getBRANCH_CODE()));
			mp.addValue("sys_date", Timestamp.valueOf(LocalDateTime.now()));
			mp.addValue("req_unique_id", nullToEmpty(generateUniqueId()));
			mp.addValue("email", nullToEmpty(email));
			mp.addValue("pincode_2", nullToEmpty(pinCode2));
			mp.addValue("mobile_number_2", nullToEmpty(mobileNumber2));

			logger.info("insertCersaiEnqResponceNew >> " + sqlInsert);
			namedParameterJdbcTemplate.update(sqlInsert, mp);
			logger.info("-----UPDATED SUCCESSFUL insertCersaiEnqResponceNew---------");

		} catch (Exception e) {
			logger.info(e.getMessage(), e);
			logger.info("-----insertCersaiEnqResponceNew FAIL ---------");
		}
	}
		
	private static String generateUniqueId() {
		Random RANDOM = new Random();
		return String.valueOf(System.currentTimeMillis()) + RANDOM.nextInt(1000000);
	}
	
	
