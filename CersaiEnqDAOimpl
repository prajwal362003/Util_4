				logger.info("jdbc template ");
			}
			String sql = "select * from kyc_customer_details cd where cd.cif_number=?";

			logger.debug("sql for getting CKYC Details::" + sql + "\nCIF Number::" + cifNumber);
			CkycDetailsBean ckycDetails = jdbcTemplate.queryForObject(sql, new Object[] { cifNumber },
					new BeanPropertyRowMapper<CkycDetailsBean>(CkycDetailsBean.class));
