		}
	}

	private CkycEnqResponseBean fetch60429(Customer customer) throws ApiNonRetryableException, RetriesExhaustedException {
		return callWithRetry(() -> cbsApiService.fetch60429(customer), "60429");
	}

	@FunctionalInterface
	private interface ApiCall<T> {
		T call() throws ApiRetryableException, ApiNonRetryableException;
	}

	private <T> T callWithRetry(ApiCall<T> apiCall, String apiName) throws ApiNonRetryableException, RetriesExhaustedException {
		int attempt = 0;
		while (true) {
			attempt++;
			try {
				return apiCall.call();
			} catch (ApiNonRetryableException nonRetryable) {
				throw nonRetryable; // no point retrying a business rejection
			} catch (ApiRetryableException retryable) {
				if (attempt >= maxApiRetries) {
					throw new RetriesExhaustedException(apiName + " failed after " + attempt + " attempts: " + retryable.getMessage());
				}
				logger.error("{} attempt {} failed, retrying: {}", apiName, attempt, retryable.getMessage());
				sleepQuietly(retryBackoffMillis * attempt); // simple linear backoff
			}
		}
	}

	private static void sleepQuietly(long millis) {
		try {
			TimeUnit.MILLISECONDS.sleep(millis);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
		}
	}

	private static boolean checkCkycNumber(String ckycNumber) {
		if(ckycNumber==null||ckycNumber.isEmpty()) return false;
		return ckycNumber.matches("\\d{14}");
	}



	private static void deleteDirectoryRecursively(Path target) throws IOException {
		if(!Files.exists(target)) return;
		try(Stream<Path> paths = Files.walk(target)){
			paths.sorted(Comparator.reverseOrder())
			.forEach(path->{
				try {
					Files.delete(path);
				}catch(IOException e) {
					throw new UncheckedIOException(e);
				}
			});
		}catch(UncheckedIOException e) {
			logger.error("exception: {}", e.getCause());
		}
	}

	private record FolderWithTime(Path path, long lastModifiedMillis) { }

	private boolean belongsToThisServer(String customerId) {
		if (clusterSize <= 1) return true;
		int shard = Math.floorMod(customerId.hashCode(), clusterSize);
		logger.info("shard {}",shard);
		return shard == serverIndex;
	}

	private List<Path> fetchOldestFolders(Path inputDir, int limit) {
		long now = System.currentTimeMillis();
		long stabilityMillis = TimeUnit.SECONDS.toMillis(stabilityWindowSeconds);
		logger.info("staleMillis {} and now {}",stabilityMillis,now);
		List<FolderWithTime> eligible = new ArrayList<>();

		try (DirectoryStream<Path> stream = Files.newDirectoryStream(inputDir, Files::isDirectory)) {
			for (Path folder : stream) {
				logger.info("folder : "+folder);
				try {
					BasicFileAttributes attrs = Files.readAttributes(folder, BasicFileAttributes.class);
					FileTime lastModified = attrs.lastModifiedTime();
					logger.info("lastModified "+lastModified.toMillis());
					if (now - lastModified.toMillis() < stabilityMillis) {
						logger.info("Too fresh - might still be uploading. Skip this cycle.");
						continue;
					}
					if (!belongsToThisServer(folder.getFileName().toString())) {
						logger.info("staleMillis {} and now {}",stabilityMillis,now);
						continue; // another server's shard this round
					}
					eligible.add(new FolderWithTime(folder, lastModified.toMillis()));

				} catch (IOException e) {
					logger.error("Could not read attributes for {}, skipping this cycle: {}", folder, e.getMessage());
				}
			}
		} catch (IOException e) {
			throw new UncheckedIOException("Failed to list input directory " + inputDir, e);
		}

		eligible.sort(Comparator.comparingLong(f -> f.lastModifiedMillis)); // oldest first

		List<Path> result = new ArrayList<>(Math.min(limit, eligible.size()));
		for (int i = 0; i < eligible.size() && i < limit; i++) {
			logger.info("eligible path "+eligible.get(i).path);
			result.add(eligible.get(i).path);
		}
		return result;
	}


	private Path claimFolder(Path sourceFolder, Path processingDir) {
		String customerId = sourceFolder.getFileName().toString();
		Path target = processingDir.resolve(customerId);
		try {
			Files.createDirectories(processingDir);
			Path moved = Files.move(sourceFolder, target, StandardCopyOption.ATOMIC_MOVE);
			logger.info("Path moved : "+moved);
			writeClaimMarker(moved);
			return moved;
		} catch (NoSuchFileException | FileAlreadyExistsException e) {
		
			logger.error("Skipping {} - already claimed or conflicting target exists", customerId);
			return null;
		} catch (IOException e) {
			logger.error("Failed to claim folder {}: {}", customerId, e.getMessage(), e);
			return null;
		}
	}



	private void writeClaimMarker(Path claimedFolder) {
		Path marker = claimedFolder.resolve(".claim");
		String content = "host=" + hostId + System.lineSeparator()+ "claimedAt=" + Instant.now() + System.lineSeparator();
		logger.info("content to write "+content);
		try {
			Files.writeString(marker, content, StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
		} catch (IOException e) {
			logger.error("Could not write claim marker for {}: {}", claimedFolder, e.getMessage());
		}
	}




	private void reconcileStaleFolders(Path processingDir, Path inputDir) {
		if (!Files.isDirectory(processingDir)) {
			return;
		}
		long staleMillis = TimeUnit.MINUTES.toMillis(staleProcessingMinutes);
		long now = System.currentTimeMillis();
		logger.info("staleMillis {} and now {}",staleMillis,now);
		try (DirectoryStream<Path> stream = Files.newDirectoryStream(processingDir, Files::isDirectory)) {
			for (Path folder : stream) {
				try {
					long referenceTime = claimMarkerTimeOrLastModified(folder);
					logger.info("referenceTime {}",referenceTime);
					if (now - referenceTime < staleMillis) {
						continue; // still within normal processing time
					}
					String customerId = folder.getFileName().toString();
					logger.info("customerId "+customerId);
					Path backToInput = inputDir.resolve(customerId);
					logger.info("backToInput {}",backToInput);
					try {
						Files.move(folder, backToInput, StandardCopyOption.ATOMIC_MOVE);
						logger.info("Reclaimed stale folder {} (idle > {} min) back to input for retry",
								customerId, staleProcessingMinutes);
					} catch (NoSuchFileException | FileAlreadyExistsException raceLost) {
						// Another server already reclaimed it (or finished it) - fine.
						logger.error("Could not evaluate {} during stale reconciliation: {}", folder, raceLost.getMessage());
					}
				} catch (IOException e) {
					logger.error("Could not evaluate {} during stale reconciliation: {}", folder, e.getMessage());
				}
			}
		} catch (IOException e) {
			logger.error("Could not scan processing dir for reconciliation: {}", e.getMessage());
		}
	}



	private long claimMarkerTimeOrLastModified(Path folder) throws IOException {
		Path marker = folder.resolve(".claim");
		if (Files.exists(marker)) {
			return Files.getLastModifiedTime(marker).toMillis();
		}
		return Files.getLastModifiedTime(folder).toMillis();
	}



	private static LocalDate parseIfPresent(String dateStr, DateTimeFormatter dtf) {
		return (dateStr!=null&&!dateStr.isEmpty())?LocalDate.parse(dateStr,dtf):null;
	}
