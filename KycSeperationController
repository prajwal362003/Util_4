	private void moveDocsWithFolder(Path claimedFolder, String customerId, String remarks, Path destination) {
		try {
			logger.info("current Folder = "+claimedFolder);
			removeClaimMarker(claimedFolder);
			if(Files.exists(destination)) deleteDirectoryRecursively(destination);
			
			Files.createDirectories(destination.getParent());
			Files.move(claimedFolder, destination, StandardCopyOption.ATOMIC_MOVE);
			//Files.move(claimedFolder, destination, StandardCopyOption.REPLACE_EXISTING);

		} catch (IOException e) {
			logger.error("Could not move {} to exception folder: {}", customerId, e.getMessage(), e);
		}
		logger.info("Folder {} moved to destinations: {}", customerId, remarks);
	}

