	private static String resolveHostId() {
		try {
			return InetAddress.getLocalHost().getHostName() + "-" + ProcessHandle.current().pid();
		} catch (Exception e) {
			return "unknown-" + ProcessHandle.current().pid();
		}
	}

	public void seperateDocuments() {
		Set<String> lcpcSet=Arrays.stream(lcpcLists.split(",")).collect(Collectors.toSet());
		for(String lcpc: lcpcSet) {
			String inputPathLcpc=inputPath+"/"+lcpc;
			String inputProcessPathLcpc=processigPath+"/"+lcpc;
			seperateDocumentsOfLCPC(inputPathLcpc,inputProcessPathLcpc,lcpc);
		}
	}


	public void seperateDocumentsOfLCPC(String inputPathLcpc, String inputProcessPathLcpc, String lcpc) {
		//LCPC_NAME
		Path inputDir = Paths.get(inputPathLcpc);
		Path processingDir = Paths.get(inputProcessPathLcpc);
		logger.info("inputDir {} and processigPath {}", inputDir, processingDir);
		reconcileStaleFolders(processingDir, inputDir);

		List<Path> candidates = fetchOldestFolders(inputDir, batchSize);
		logger.info("Fetched {} candidate folders for this batch", candidates.size());
		if (candidates.isEmpty()) {
			logger.info("No eligible customer folders found in {}", inputDir);
			return;
		}
		logger.info("List of folders : "+candidates);

		for (Path customerFolder : candidates) {
			String customerId = customerFolder.getFileName().toString();
			logger.info("customerId : "+customerId);
			Path claimed = claimFolder(customerFolder, processingDir);
			if (claimed == null) continue;
			try {
				processCustomerFolder(claimed, customerId,lcpc);
				logger.info("Customer {} processed and moved to output", customerId);
			} catch (Exception e) {
				logger.error("Processing failed for customer {}: {}", customerId, e.getMessage(), e);
				try {
					moveTo(claimed, Paths.get(failedDirPath, customerId));
				} catch (IOException moveEx) {
					logger.error("Could not move failed folder {} out of processing dir: {}", customerId, moveEx.getMessage(), moveEx);
				}
			}
		}
	}


	private void moveTo(Path source, Path target) throws IOException {
		if(Files.exists(target)){
			deleteDirectoryRecursively(target);
		}
		Files.createDirectories(target.getParent());
		Files.move(source, target, StandardCopyOption.ATOMIC_MOVE);
	}

	private void processCustomerFolder(Path claimedFolder, String customerId,String lcpc) {
		String remarks="";
		boolean rejectCustomer=false;
		FolderIdentifier id;
		String[] folderValues=customerId.split("_");
		Customer customer = new Customer(folderValues[0],folderValues[1],folderValues[2]);
		try {
			id = FolderIdentifier.parse(customerId);
		} catch (IllegalArgumentException badName) {
			generateResponse(false,claimedFolder,customerId,customer,"INVALID_FOLDER_NAME: " + badName.getMessage(),lcpc,"",status);
			//moveToException(claimedFolder,lcpc, customerId, "INVALID_FOLDER_NAME: " + badName.getMessage());
			return;
		}

		if (!customerService.checkStatusInPerfiosTable(customer.cifNumber())) {
			generateResponse(false, claimedFolder, customerId,  customer,  "CIF UNDER PROCESS ", lcpc,"",status);
			//moveToException(claimedFolder,lcpc, customerId, "CIF UNDER PROCESS ");
			return;
		}

		CkycEnqResponseBean cbs60429Data=null;
		try {
			cbs60429Data =fetch60429(customer); //cbsApiService.fetch60429(customer);  //60429 should be complete - Expected enquiry response 0
		}catch(Exception apiFailure) {
			generateResponse(false, claimedFolder, customerId,  customer,  "CBS API_FAILURE: " + apiFailure.getMessage(), lcpc,"",status);
			//moveToException(claimedFolder, lcpc, customerId, "CBS API_FAILURE: " + apiFailure.getMessage());
			// customerDao.insertHistory(id.cif(), "Moved to exception - API failure: " + apiFailure.getMessage());
			return;
		}
		logger.info(" cbs60429Data  "/* +cbs60429Data */);
		String ckyc_number = "";
		if (cbs60429Data != null) {
			if(cbs60429Data.getRESPONSE_STATUS().equals("1")) {
				logger.info(" Response Message from 60429 API :   "+cbs60429Data.getERROR_DESCRIPTION());
				generateResponse(false, claimedFolder, customerId,  customer,  "CBS Enquiry_th - "+cbs60429Data.getERROR_DESCRIPTION(), lcpc,"",status);
				//moveToException(claimedFolder,lcpc, customerId, cbs60429Data.getERROR_DESCRIPTION());
				return ;
			}

			try{
				cbsApiService.save60429IntoCkyc(cbs60429Data,customer);
			}catch(Exception e) {
				logger.info(" Error while saving 60429 data  ");
			}

			try{
				ckyc_number = cbs60429Data.getCKYC_PERSONAL_DETAILS().getCKYC_NUMBER();
			}catch(Exception ex) {
				logger.error("Exception: " + ex.getMessage());
			}
			logger.info("ckyc_number: " + ckyc_number);
		} else {
			logger.error("Error: CBS Data could not be fetched. Check encryption/certificate logs.");
		}

		CustomerNormalDetailsEnquiryResponse cbs67000Data = cbsApiService.fetch67000data(customer); //Receive kyc update date from CBS

		String cbs_kyc_date = "";
		if (cbs67000Data != null) {
			if(cbs67000Data.getRESPONSE_STATUS().equals("1")) {
				logger.info(" Response Message from 67000 API :   "+cbs67000Data.getERROR_DESCRIPTION());
				generateResponse(false, claimedFolder, customerId,  customer,  "CBS NormalDetailsEnquiry - "+cbs67000Data.getERROR_DESCRIPTION(), lcpc,"",status);
				//moveToException(claimedFolder,lcpc, customerId, cbs60429Data.getERROR_DESCRIPTION());
				return;
			}

			try{
				cbsApiService.save67000IntoCkyc(cbs67000Data,cbs60429Data,customer);
			}catch(Exception e) {
				logger.info(" Error while saving 60429 data  ");
			}
			cbs_kyc_date = cbs67000Data.getKYC_DETAILS_UPDATED_ON();
			logger.info("CBS KYC Date: " + cbs_kyc_date);
		} else {
			logger.error("Error: CBS Data could not be fetched. Check encryption/certificate logs.");
		}

		boolean ckycNumberExist=checkCkycNumber(cbs60429Data.getCKYC_PERSONAL_DETAILS().getCKYC_NUMBER());
		logger.info("ckycNumberExist : " +ckycNumberExist);

		if(ckycNumberExist) {
			generateResponse(false, claimedFolder, customerId,  customer,  "Ckyc number alredy present in CBS", lcpc,ckyc_number,status);	
			logger.info("Process completed for a customer "+claimedFolder.getFileName());
			return;
		}		

		DateTimeFormatter dtf = DateTimeFormatter.ofPattern("ddMMyyyy");
		
		boolean cbsDateIsLatest=false;
		boolean lcpcDateIsLatest=false;

		LocalDate cbsDate =null;
		LocalDate lcpcDate =null;

		String branchKycDate=customerService.fetchBranchKycDate(customer.cifNumber());
		try { 
			logger.info(" Date received from branch :    "+branchKycDate);

			lcpcDate=parseIfPresent(branchKycDate,dtf);
			cbsDate=parseIfPresent(cbs_kyc_date,dtf);
			
		//	cbsDate =  LocalDate.parse("2026-08-22");

			if (cbsDate != null && lcpcDate != null) {
				if (cbsDate.isAfter(lcpcDate)) {
					logger.info("CBS record is more recent than LCPC/Branch.");
					long diffDays = ChronoUnit.DAYS.between(lcpcDate, cbsDate);
					if(diffDays<=allowdDiffDays) {
						logger.info(" CBS date is ahead of "+diffDays+". Considering both dates are same ");
						cbsDateIsLatest=true;
					}else {
						remarks="Found date difference more than "+allowdDiffDays;
						rejectCustomer=true;
					}				
					cbsDateIsLatest = true;
				} else if (cbsDate.isBefore(lcpcDate)) {
					logger.info("Lcpc record is more recent than CBS date");
					lcpcDateIsLatest = true;
				}
			} else if (cbsDate != null) {
				logger.info("LCPC date is not available");
				cbsDateIsLatest=true;
			} else if (lcpcDate != null) {
				logger.info("CBS date is not available");
				lcpcDateIsLatest=true;
			}
		} catch (Exception e) {
			logger.error("Facing error parsing dates " + e.getMessage());
		}

		if(!cbsDateIsLatest&&!lcpcDateIsLatest) {
			rejectCustomer=true;
			remarks="Not found KYC update date of a customer in CBS";
		}else if(lcpcDateIsLatest) {
			rejectCustomer=true;
			remarks="Not updated customer records into CBS";
		}

		if(rejectCustomer) generateResponse(false, claimedFolder, customerId, customer, remarks, lcpc, ckyc_number,status);	

		CersaiEnquiryData cersaiEnquiryData=null;
		try {
			cersaiEnquiryData=cersaiApiService.fetchCersaidata(customer,cbs60429Data);
		} catch (Exception e) {
			logger.error("Facing error parsing dates " + e.getMessage());
			generateResponse(false, claimedFolder, customerId,  customer,  "Error from Cersai Enquiry", lcpc,ckyc_number,status);	
		}

		logger.info("CersaiEnquiryResponse : " + cersaiEnquiryData.toString());

		String cersaiKycDate=cersaiEnquiryData.kycUpdateDate();//  2026-08-25
		
		//String cersaiKycDate="2026-08-25";

		boolean cersaiDateIsLatest=false;
		try {
			logger.info("cbs kyc date : " +cbsDate+"   |   Date received from Cersai "+cersaiKycDate);
			LocalDate cersaiDate = parseIfPresent(cersaiKycDate, DateTimeFormatter.ofPattern("dd-MM-yyyy"));//25-08-2026
			logger.info("cersai Date  "+cersaiDate);
			
			if (cbsDate != null && cersaiDate != null) {			
				logger.info("cersai Date : "+cersaiDate+ "   | cbsDate : " +cbsDate);
				
				if (cbsDate.isAfter(cersaiDate)) {
					logger.info("CBS record is more recent than CERSAI.");
					cbsDateIsLatest = true;
				} else if (cbsDate.isBefore(cersaiDate)) {
					logger.info("CERSAI record is more recent than CBS.");
					cersaiDateIsLatest = true;
				} else {
					logger.info("Both dates are the same.");
				}
			} else if (cbsDate != null) {
				logger.info("CERSAI date is not available. Considering CBS date as latest.");
				cbsDateIsLatest = true;
			} else if (cersaiDate != null) {
				logger.info("CBS date is not available. Considering CERSAI date as latest.");
				cersaiDateIsLatest = true;
			} else {
				logger.info("Both dates are not available.");
			}
		} catch (Exception e) {
			logger.error("Facing error parsing dates " + e.getMessage());
		}
		boolean perfios=false;
		if (cersaiDateIsLatest) {
			logger.info("Skipping the Kyc documents seperation for perfios as ckyc number/reference found and the CKYC date fall ahead");
			//remarks="Found latest KYC update date in cersai";
			remarks="No updation required, Found latest KYC update date in cersai";
			status="KS";
		}else {
			try {
				logger.info("File seperating " );
				fileSeperation.seperateKycDocs(claimedFolder, lcpc);
				perfios=true;
				remarks="Successfully sepearted KYC documents to send it to Perfios";
				status="ZP";
			} catch (Exception e) {
				logger.error(" >>" +e.getMessage());
			}
			
		}
		logger.info("remarks {}",remarks);
		generateResponse(perfios,  claimedFolder,  customerId,  customer,  remarks,lcpc,ckyc_number,status);	
		logger.info("Process completed for a customer "+claimedFolder.getFileName());
	}

