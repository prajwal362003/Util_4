	public void updateKycIdentificationDetails(CustomerNormalDetailsEnquiryResponse normDetails, String cifNumber) {

		String identification_type=cbsMappingIdType(normDetails.getOVD_KYC_DOCUMENT_TYPE());
		logger.info("identification_type : " + identification_type);

		String expiryDate="";
		if(identification_type.equalsIgnoreCase("A")){
			expiryDate = normDetails.getPASSPORT_EXPIRY_DATE();
		}else if(identification_type.equalsIgnoreCase("D")){
			expiryDate = normDetails.getDRIVING_EXPIRY_DATE();
		}

		int count = 0;

		MapSqlParameterSource mp = new MapSqlParameterSource();
		mp.addValue("cifNumber",cifNumber);
		mp.addValue("identification_type",identification_type);
		mp.addValue("identity_number",normDetails.getOVD_KYC_DOCUMENT_DETAILS());
		mp.addValue("expiry_date", parseDateToSql(expiryDate));//dd-mm-yyyy
		mp.addValue("issued_at", normDetails.getID_ISSUED_AT());
		mp.addValue("issued_date",parseDateToSql(normDetails.getID_ISSUED_DATE()));
		//	mp.addValue("issued_by",normDetails.getID_ISSUED_BY());
		mp.addValue("identification_type_2",normDetails.getSECOND_ID_TYPE());
		mp.addValue("identity_number_2",normDetails.getSECOND_ID_NUMBER());
		mp.addValue("cbs_id_type",normDetails.getOVD_KYC_DOCUMENT_TYPE()); 

		String queryToUpdateIdentificationDetails = "update kyc_identification_details set identification_type=:identification_type,identity_number=:identity_number,expiry_date=:expiry_date, "
				+ "issued_at=:issued_at,issued_date=:issued_date,identification_type_2=:identification_type_2, identity_number_2=:identity_number_2,cbs_id_type=:cbs_id_type where cif_number_fk=:cifNumber";
		logger.info("kyc identification details query : " + queryToUpdateIdentificationDetails);//IDENTITY_NUMBER_2

		try {
			count = namedParameterJdbcTemplate.update(queryToUpdateIdentificationDetails, mp);
		}catch(Exception e) {
			logger.info(e.getLocalizedMessage());
			logger.error(e);
		}
		logger.info("No of rows modified in kyc_identification_details : " + count);
	}

	private String cbsMappingIdType(String cbsCode) {
		logger.info("OVD_KYC_DOCUMENT_TYPE : " + cbsCode);
		String idTypeFetchQuery="select ckyc_code from gcdckyc.kyc_cbs_api_mapping where cbs_code=:cbs_code";
		logger.info("idTypeFetchQuery : " + idTypeFetchQuery);
		MapSqlParameterSource mp = new MapSqlParameterSource();
		mp.addValue("cbs_code", cbsCode);
		try {
			
			List<String> idTypeList=namedParameterJdbcTemplate.queryForList(idTypeFetchQuery, mp, String.class);
			if(idTypeList==null||idTypeList.isEmpty()) {
				return "";
			}
			if(idTypeList.size()>1) {
				logger.info("Multiple rows found for cbs_code "+cbsCode+". Returning first value "+idTypeList.get(0));
			}
			return idTypeList.get(0);
		}catch(Exception e) {
			logger.error(e.getLocalizedMessage());
			logger.error(e);
			return "";
		}
	}

	private Date parseDateToSql(String stringDate) {
		Date sqlParsedExpiryDate=null;
		try {
			logger.info("stringDate : "+stringDate);
			if(stringDate!=null&&!stringDate.trim().isEmpty()
					&&!stringDate.contains("00000000")&&!stringDate.contains("00-00-0000")&&!stringDate.contains("99999999")) {
				LocalDate localdate = LocalDate.parse(stringDate,
						DateTimeFormatter.ofPattern("ddMMyyyy"));
				sqlParsedExpiryDate=java.sql.Date.valueOf(localdate);
				logger.info("sqlParsedExpiryDate : " + sqlParsedExpiryDate);
			}
		}catch(Exception e) {
			logger.error(e.getLocalizedMessage());
