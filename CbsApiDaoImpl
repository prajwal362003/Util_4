					&& CompareData(address.getADDRESS_LINE_2(),address.getCORRESPONDENCE_ADDRESS_LINE_2())
					&&CompareData(address.getADDRESS_LINE_3(),address.getCORRESPONDENCE_ADDRESS_LINE_3()) 
					&& CompareData(address.getPOST_CODE(),address.getCORRESPONDENCE_ADDRESS_PIN_CODE()) /*&& CompareData(address.getState(),address.getCorrespondantState()) */){
				flag = "Y";
			}
		}catch(Exception e){
			logger.info(e.getMessage());
		}

		return flag;
	}

	public boolean CompareData(String a, String b){
		if(a != null && b != null){
			return a.equalsIgnoreCase(b);
		}
		return false;
	}

	public String removeDoubleOrMoreSpaces(String inputStr){
		if(inputStr != null){
			return inputStr.replaceAll("\\s{2,}", " ").replaceAll("\\\"+", "");
		}else{
			return inputStr;
		}
	}

	private String cbsToCKYCAddressProof(String addressProof){
		String ckycAddressProof="";
		if(addressProof.equalsIgnoreCase("A")){
			ckycAddressProof="02";
		}else if(addressProof.equalsIgnoreCase("B")){
			ckycAddressProof="04";
		}else if(addressProof.equalsIgnoreCase("C")){
			ckycAddressProof="";
		}else if(addressProof.equalsIgnoreCase("D")){
			ckycAddressProof="03";
		}else if(addressProof.equalsIgnoreCase("E")){
			ckycAddressProof="01";
		}else if(addressProof.equalsIgnoreCase("F")){
			ckycAddressProof="05";
		}else if(addressProof.equalsIgnoreCase("Z")){
			ckycAddressProof="99";
		}else if(addressProof.equalsIgnoreCase("S")){
			ckycAddressProof="S";
		}else if(addressProof.equalsIgnoreCase("H")){
			ckycAddressProof="09";
		}else {
			ckycAddressProof=addressProof;
		}

		logger.info("ckycAddressProof : "+ckycAddressProof);
		return ckycAddressProof;
	}


	public String getAddressTypeValue(CKYC_ADDRESS_DETAILS addr) {
		String result = "";
		try{
			if(CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_ADDRESS_LINE_1(),addr.getADDRESS_LINE_1()) && CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_ADDRESS_LINE_2(),addr.getADDRESS_LINE_2())&&
					CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_ADDRESS_LINE_3(),addr.getADDRESS_LINE_3()) && /*CompareData(address.getState(),address.getCorrespondantState()) &&*/
					CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_POST_CODE(),addr.getPOST_CODE()) ){
				result = "P";
			}
			else if(CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_ADDRESS_LINE_1(),addr.getCORRESPONDENCE_ADDRESS_LINE_1()) && CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_ADDRESS_LINE_2(),addr.getCORRESPONDENCE_ADDRESS_LINE_2())&&
					CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_ADDRESS_LINE_3(),addr.getCORRESPONDENCE_ADDRESS_LINE_3()) && /*CompareData(address.getState(),address.getCorrespondantState()) &&*/
					CompareData(addr.getJURISDICTION_OUTSIDE_INDIA_POST_CODE(),addr.getCORRESPONDENCE_ADDRESS_PIN_CODE()) ){
				result = "C";
			}else {
				result = "";
			}
		}catch(Exception e){
			logger.info(e.getMessage());
		}
		logger.info("get Address type value " + result);
		return result;
	}

