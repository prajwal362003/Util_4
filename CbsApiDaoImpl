	public HashMap<String, String> getMobileNo(CKYC_PERSONAL_DETAILS personalDetail){
		HashMap<String, String> mobileCodeNoMap = new HashMap<String, String>();
		if(personalDetail.getMOBILE_NUMBER() !=null && !personalDetail.getMOBILE_NUMBER().equalsIgnoreCase("")){
			try{
				if(personalDetail.getMOBILE_NUMBER().length()==12){
					mobileCodeNoMap.put("mobileCode", personalDetail.getMOBILE_NUMBER().substring(0, 2));
					mobileCodeNoMap.put("mobileNo", personalDetail.getMOBILE_NUMBER().substring(2));
				}else if(personalDetail.getMOBILE_NUMBER().length()==11){
					mobileCodeNoMap.put("mobileCode", personalDetail.getMOBILE_NUMBER().substring(0, 1));
					mobileCodeNoMap.put("mobileNo", personalDetail.getMOBILE_NUMBER().substring(1));
				}else if(personalDetail.getMOBILE_NUMBER().length()<=10){
					mobileCodeNoMap.put("mobileNo", personalDetail.getMOBILE_NUMBER());
				}else{
					// do nothing
				}
				return mobileCodeNoMap;
			}catch(Exception e){
				logger.info("Exception in fax no");
				logger.error(e);
				return mobileCodeNoMap;
			}
		}

		return mobileCodeNoMap;
	}

